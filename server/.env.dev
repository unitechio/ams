# Environment: Development
APP_ENV=dev

# Server Configuration
HOST=0.0.0.0
PORT=8080
TZ=Asia/Ho_Chi_Minh
PUBLIC_URL=http://localhost:8080
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration
# Format: host=... port=... user=... password=... dbname=... sslmode=... TimeZone=...
DB_DSN=host=localhost port=5433 user=postgres password=postgres dbname=auth_dev sslmode=disable TimeZone=Asia/Ho_Chi_Minh
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=15m

# Redis Configuration (Optional)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=super-secret-dev-key
JWT_ISSUER=ams-auth-server-dev
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Security & Features
ENABLE_METRICS=true
ENABLE_PPROF=true
ENABLE_SECURITY_HEADERS=true
