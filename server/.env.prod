# Environment: Production
APP_ENV=prod

# Server Configuration
HOST=0.0.0.0
PORT=8080
TZ=Asia/Ho_Chi_Minh
PUBLIC_URL=https://auth.yourdomain.com
CORS_ALLOW_ORIGINS=https://app.yourdomain.com

# Database Configuration
DB_DSN=host=postgres port=5432 user=einfra password=einfra123 dbname=demo sslmode=require TimeZone=Asia/Ho_Chi_Minh
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=20
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=30m

# Redis Configuration
REDIS_ADDR=redis:6379
REDIS_PASSWORD=prod_redis_secret
REDIS_DB=0

# JWT Configuration
# MUST CHANGE IN PRODUCTION
JWT_SECRET=very-secure-production-secret-key-12345!
JWT_ISSUER=ams-auth-server
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Security & Features
ENABLE_METRICS=true
ENABLE_PPROF=false
ENABLE_SECURITY_HEADERS=true
