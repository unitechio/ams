APP_IMAGE=ghcr.io/owner/ams
APP_TAG=latest

ENV=production
HOST=0.0.0.0
PORT=8080
PUBLIC_URL=https://ams.example.com
TZ=Asia/Ho_Chi_Minh
CORS_ALLOW_ORIGINS=https://ams.example.com,https://admin.example.com

JWT_SECRET=change-this-in-production
JWT_ISSUER=ams-auth-server
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

ENABLE_METRICS=true
ENABLE_PPROF=false
ENABLE_SECURITY_HEADERS=true
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=15m

REDIS_PASSWORD=change-this-too
REDIS_DB=0

HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=20s

PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
DOMAIN=ams.example.com
ACME_EMAIL=ops@example.com
